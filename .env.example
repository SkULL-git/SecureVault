# Copy this file to .env and replace all example secrets.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Local SQLite default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/securevault
DATABASE_URL=sqlite:///securevault.db

# Set true only when serving HTTPS in production.
SESSION_COOKIE_SECURE=false
